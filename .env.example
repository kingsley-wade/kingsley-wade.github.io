# Public deployment settings. Do not place secrets in PUBLIC_* variables.
PUBLIC_SITE_URL=https://kingsley-wade.github.io
BASE_URL=/
PUBLIC_THEME_PRESET=pastel-sky
# Set by CI to the deployed commit SHA. Local builds fall back to "local".
PUBLIC_COMMIT_SHA=

# Optional future assistant gateway. Leave empty to show the offline state.
PUBLIC_ASSISTANT_API_BASE_URL=

# Future assistant gateway settings (server environment only; no secrets here).
# ASSISTANT_ALLOWED_ORIGIN=https://kingsley-wade.github.io
# ASSISTANT_OIDC_ISSUER=https://identity.example
# ASSISTANT_OIDC_CLIENT_ID=public-pkce-client
# ASSISTANT_OIDC_AUDIENCE=personal-notes-api

# Optional legal background-audio source. Commercial audio is not bundled.
PUBLIC_BACKGROUND_AUDIO_URL=
PUBLIC_BACKGROUND_AUDIO_TITLE=Personal Theme
PUBLIC_BACKGROUND_AUDIO_ARTIST=Configured source
