---
import { withBase } from "../config/site";
import { photoGroups } from "../content/photos/gallery";

const groups = photoGroups.map((group) => ({
  ...group,
  photos: group.photos.map((photo) => ({
    ...photo,
    src: withBase(photo.src),
  })),
}));
---

<section class="photo-gallery" aria-label="Photo gallery" data-photo-gallery>
  <div class="photo-groups">
    {
      groups.map((group) => (
        <div class="photo-group" data-photo-group={group.id}>
          <button
            type="button"
            class="photo-group__header"
            data-photo-group-toggle
            aria-expanded="false"
            aria-controls={`photo-group-panel-${group.id}`}
          >
            <span class="photo-group__marker" aria-hidden="true">&gt;</span>
            <span class="photo-group__title">{group.title}</span>
            <span class="photo-group__blurb">{group.blurb}</span>
            <span class="photo-group__count">[{group.photos.length}]</span>
          </button>
          <div class="photo-group__panel" id={`photo-group-panel-${group.id}`} hidden>
            <div class="photo-gallery__grid">
              {group.photos.map((photo) => (
                <button
                  class="photo-gallery__tile"
                  type="button"
                  data-photo-open={photo.id}
                  data-photo-caption={photo.caption}
                  aria-haspopup="dialog"
                >
                  <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <dialog class="photo-gallery__dialog" data-photo-dialog aria-label="Photo viewer">
    <button class="photo-gallery__close" type="button" data-photo-close aria-label="Close photo viewer">
      Close
    </button>
    <img data-photo-dialog-image alt="" />
    <p class="photo-gallery__dialog-caption" data-photo-dialog-caption hidden></p>
  </dialog>
</section>

<script>
  import { initPhotoGallery } from "../lib/photos/photo-gallery-client";

  document.querySelectorAll<HTMLElement>("[data-photo-gallery]").forEach((root) => {
    initPhotoGallery(root);
  });
</script>
