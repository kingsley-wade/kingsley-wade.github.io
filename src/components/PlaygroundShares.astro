---
import { render, type CollectionEntry } from "astro:content";

type Props = { entries: CollectionEntry<"shares">[] };
const { entries } = Astro.props;
const renderedEntries = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: entry.data.kind === "note" ? (await render(entry)).Content : null,
  })),
);
const links = renderedEntries.filter(({ entry }) => entry.data.kind === "link");
const notes = renderedEntries.filter(({ entry }) => entry.data.kind === "note");
---

<div class="playground-shares" data-playground-shares>
  <section class="playground-block reading-shelf" aria-labelledby="reading-shelf-title" data-share-kind-group="link">
    <header class="playground-block__header">
      <p class="playground-block__eyebrow">SHELF / LINKS</p>
      <h3 id="reading-shelf-title">Reading Shelf</h3>
    </header>
    {links.length > 0 ? (
      <ul class="reading-shelf__list">
        {links.map(({ entry }) => {
          if (entry.data.kind !== "link") return null;
          return (
            <li id={entry.id} data-share-id={entry.id} data-share-kind="link" tabindex="-1">
              <a href={entry.data.sourceUrl} target="_blank" rel="noreferrer">{entry.data.title}</a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="content-panel__empty">No links on the shelf yet.</p>
    )}
  </section>

  <section class="playground-block playground-notes" aria-labelledby="playground-notes-title" data-share-kind-group="note" hidden>
    <header class="playground-block__header">
      <p class="playground-block__eyebrow">NOTES / LOCAL</p>
      <h3 id="playground-notes-title">Notes</h3>
    </header>
    {notes.map(({ entry, Content }) => {
      if (entry.data.kind !== "note") return null;
      return (
        <article class="content-entry playground-share" id={entry.id} data-share-id={entry.id} data-share-kind="note" tabindex="-1">
          <h4>{entry.data.title}</h4>
          {entry.data.summary ? <p>{entry.data.summary}</p> : null}
          {entry.data.tags.length > 0 ? <p>{entry.data.tags.join(" / ")}</p> : null}
          {Content ? <div class="playground-share__body"><Content /></div> : null}
        </article>
      );
    })}
  </section>
</div>

<script>
  const container = document.querySelector<HTMLElement>("[data-playground-shares]");
  const applyPath = (path: string) => {
    if (!container) return;
    const showNotes = path === "/playground/notes";
    const notes = container.querySelector<HTMLElement>('[data-share-kind-group="note"]');
    const links = container.querySelector<HTMLElement>('[data-share-kind-group="link"]');
    if (notes) notes.hidden = !showNotes;
    if (links) links.hidden = showNotes;
  };
  applyPath("/playground");
  window.addEventListener("terminal:path-changed", (event) => {
    const path = (event as CustomEvent<{ path?: string }>).detail?.path ?? "/playground";
    applyPath(path);
  });
</script>
