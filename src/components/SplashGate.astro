<section class="splash-gate" data-splash-gate aria-labelledby="splash-title">
  <div class="splash-gate__scanline" aria-hidden="true"></div>
  <p class="splash-gate__status" data-splash-date>PLAYER 01 · READY</p>
  <h1 id="splash-title">WELCOME IN</h1>
  <p class="splash-gate__name">MANTING.GUO</p>
  <div class="splash-gate__actions">
    <button type="button" data-enter-mode="sound">START WITH SOUND</button>
    <button type="button" data-enter-mode="muted">ENTER MUTED</button>
  </div>
</section>

<script>
  history.scrollRestoration = "manual";

  const gate = document.querySelector<HTMLElement>("[data-splash-gate]");
  const dateLabel = document.querySelector<HTMLElement>("[data-splash-date]");
  if (dateLabel) {
    const now = new Date();
    const date = now
      .toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" })
      .toUpperCase();
    dateLabel.textContent = date;
  }

  const enterSite = (muted: boolean) => {
    if (!gate || gate.hidden) return;
    gate.hidden = true;
    document.documentElement.dataset.entered = "true";
    if (!window.location.hash) {
      window.scrollTo({ top: 0, left: 0, behavior: "instant" });
    }
    window.dispatchEvent(new CustomEvent("site:entered", { detail: { muted } }));
    document
      .querySelector<HTMLElement>("[data-menu-toggle]")
      ?.focus({ preventScroll: true });
  };

  gate?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
      "[data-enter-mode]",
    );
    if (button) enterSite(button.dataset.enterMode === "muted");
  });

  window.addEventListener("keydown", (event) => {
    if (event.key === "Enter" && gate && !gate.hidden) {
      event.preventDefault();
      enterSite(false);
    }
  });
</script>
