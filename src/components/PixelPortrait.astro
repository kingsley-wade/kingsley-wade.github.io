---
import { withBase } from "../config/site";

const avatar = withBase("images/avatar-cartoon.webp");
---

<picture class="terminal-identity__portrait">
  <img
    src={avatar}
    srcset={`${avatar} 480w`}
    sizes="(max-width: 480px) 120px, 200px"
    width="480"
    height="480"
    alt="Pixel-art cartoon avatar of Manting Guo"
    decoding="async"
    fetchpriority="high"
  />
</picture>
